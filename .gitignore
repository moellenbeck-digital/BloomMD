vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.DS_Store

# Obsidian test vault: track only the curated fixtures.
# Everything else is local state — window layout, plugin node positions, the installed plugin
# build, and notes created while testing by hand. Default-deny so a stray file (a pasted secret,
# an accidental note) can never be swept into a commit by `git add -A`.
obsidian-test-vaults/**
!obsidian-test-vaults/*/
!obsidian-test-vaults/*/.obsidian/
!obsidian-test-vaults/*/.obsidian/app.json
!obsidian-test-vaults/*/.obsidian/appearance.json
!obsidian-test-vaults/*/.obsidian/community-plugins.json
!obsidian-test-vaults/*/.obsidian/core-plugins.json
!obsidian-test-vaults/*/.obsidian/graph.json
!obsidian-test-vaults/*/BloomMD Plugin Test.md
!obsidian-test-vaults/*/Willkommen.md
# Navigator fixtures: nested folders, equal file names in several folders, a very long file name.
!obsidian-test-vaults/*/Navigator/
!obsidian-test-vaults/*/Navigator/**

# Electrobun distributables. A stable build writes a DMG and a packed bundle here; these are release
# outputs of tens of megabytes and belong in CI artifacts, not in the repository.
packages/desktop/artifacts/

# Compiled single binaries from `bun build --compile`, around 60-110 MB each depending on target.
# Same reasoning: release output, not source.
/artifacts/

# Generated during the macOS icon build; the committed source is assets/AppIcon.iconset.
packages/desktop/assets/*.icns
