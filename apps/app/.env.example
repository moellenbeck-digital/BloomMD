# BloomMD Product App Configuration
# App root: apps/app, domain: https://bloommd.app

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3210
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3210
NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:3212

# Closed beta
# BLOOMMD_BETA_ACCESS=1 -> signup only with an invitation (allowlist, code or database invite).
# Anything else (0 or unset) -> open self-registration without an invitation. Email confirmation,
# consent to privacy policy/terms and the signup rate limits apply in both states.
BLOOMMD_REQUIRE_AUTH=0
BLOOMMD_BETA_ACCESS=0
# Fallback/bootstrap only. Normal closed-beta invites are stored in the app database.
BLOOMMD_BETA_ALLOWED_EMAILS=
BLOOMMD_BETA_INVITE_CODES=
BLOOMMD_INTERNAL_INVITE_SECRET=
BLOOMMD_AUTH_SECRET=replace-with-a-long-random-secret
BLOOMMD_ALLOWED_EMAILS=

# Source address for rate limits (#169). Name of the one request header that is believed, e.g.
# cf-connecting-ip or x-vercel-forwarded-for, only if the proxy in front overwrites it. Unset: the
# last x-forwarded-for entry (right behind exactly one proxy). Missing in a production build: all
# such requests are counted together.
BLOOMMD_TRUSTED_PROXY_HEADER=

# Global cap for outgoing account mails (confirmation and password reset, #169), counted in the
# database. When reached, sign-up answers "temporarily unavailable" and no mail is sent. Invitation
# and beta mails are not counted. Defaults: 60 per hour, 300 per day (UTC windows).
BLOOMMD_MAIL_HOURLY_LIMIT=60
BLOOMMD_MAIL_DAILY_LIMIT=300

# Unconfirmed accounts are deleted by `db:maintenance` after this many days (#169).
BLOOMMD_UNCONFIRMED_ACCOUNT_RETENTION_DAYS=7

# Local/self-hosted file mode
BLOOMMD_DIR=./data
BLOOMMD_API_KEY=
BLOOMMD_STORAGE_MODE=auto

# Product database
DATABASE_URL=
BLOOMMD_AUTO_MIGRATE=0
BLOOMMD_DELETED_DOCUMENT_RETENTION_DAYS=30
BLOOMMD_STRIPE_EVENT_RETENTION_DAYS=180
BLOOMMD_AUDIT_EVENT_RETENTION_DAYS=365

# Realtime sync / collaboration
NEXT_PUBLIC_SYNC_URL=
BLOOMMD_SYNC_SECRET=
SYNC_ALLOWED_ORIGINS=https://bloommd.app,views://mainview
SYNC_MAX_ROOMS=500
SYNC_MAX_CLIENTS_PER_ROOM=100
SYNC_MAX_MESSAGE_BYTES=1048576
SYNC_REPLICA_COUNT=1
SYNC_DATABASE_URL=
SYNC_API_KEY=

# Optional OpenClaw workspace agent. The agent gets only explicitly selected document context and
# returns reviewable proposals; it never receives BloomMD database or sync credentials.

# Billing stays off for the closed beta unless all Stripe values are configured.
BLOOMMD_BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_PRICE_SYNC_MONTHLY=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=BloomMD Accounts <account@bloommd.app>

# In-app beta feedback (#127)
BLOOMMD_FEEDBACK_ENABLED=0
BLOOMMD_FEEDBACK_GITHUB_TOKEN=
BLOOMMD_FEEDBACK_GITHUB_REPO=moellenbeck-digital/BloomMD
BLOOMMD_FEEDBACK_GITHUB_PROJECT_ID=
BLOOMMD_FEEDBACK_GITHUB_STATUS_FIELD_ID=
BLOOMMD_FEEDBACK_GITHUB_FEEDBACK_OPTION_ID=
BLOOMMD_FEEDBACK_S3_ENDPOINT=
BLOOMMD_FEEDBACK_S3_REGION=eu-central-1
BLOOMMD_FEEDBACK_S3_BUCKET=
BLOOMMD_FEEDBACK_S3_ACCESS_KEY_ID=
BLOOMMD_FEEDBACK_S3_SECRET_ACCESS_KEY=
BLOOMMD_FEEDBACK_ATTACHMENT_RETENTION_DAYS=90

# Monitoring and analytics
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Legal pages
BLOOMMD_LEGAL_BUSINESS_NAME=
BLOOMMD_LEGAL_OWNER_NAME=
BLOOMMD_LEGAL_STREET=
BLOOMMD_LEGAL_POSTAL_CITY=
BLOOMMD_LEGAL_COUNTRY=Deutschland
BLOOMMD_LEGAL_EMAIL=
BLOOMMD_LEGAL_PHONE=
BLOOMMD_LEGAL_REGISTER_COURT=
BLOOMMD_LEGAL_REGISTER_NUMBER=
BLOOMMD_LEGAL_VAT_ID=
BLOOMMD_LEGAL_RESPONSIBLE_CONTENT=
