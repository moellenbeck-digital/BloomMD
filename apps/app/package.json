{
  "name": "@bloommd/web-app",
  "version": "0.5.1",
  "license": "Elastic-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3210",
    "build": "next build --webpack",
    "setup:stripe": "node scripts/setup-stripe-test-prices.mjs",
    "release:check": "bun run scripts/release-check.ts",
    "production-auth-smoke": "bun run scripts/production-auth-smoke.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:verify": "bun run scripts/verify-database.ts",
    "db:verify-restore": "bun run scripts/verify-restore.ts",
    "db:restore-drill-marker": "bun run scripts/restore-drill-marker.ts",
    "feedback:verify-storage": "bun run scripts/verify-feedback-storage.ts",
    "db:maintenance": "bun run scripts/maintenance.ts",
    "start": "next start",
    "test": "bun scripts/test-isolated.ts",
    "test:e2e": "playwright test",
    "test:e2e:beta": "playwright test --config playwright.beta.config.ts",
    "test:e2e:open-signup": "playwright test --config playwright.open-signup.config.ts",
    "test:e2e:collaboration": "playwright test --config playwright.collaboration.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e:wiki": "playwright test --config playwright.wiki.config.ts",
    "test:e2e:testsystem": "playwright test --config playwright.testsystem.config.ts"
  },
  "dependencies": {
    "@bloommd/core": "workspace:*",
    "@bloommd/ui": "workspace:*",
    "@sentry/nextjs": "^10.76.2",
    "fumadocs-core": "^16.14.2",
    "import-in-the-middle": "^3.3.3",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "posthog-js": "^1.414.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "require-in-the-middle": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/bun": "^1.3.14",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
