# Admin app (apps/cms). Local development only; production values come from 1Password and External
# Secrets and never from the repository. Copy to .env.local.

# Own database (never the app database; the CMS must not get DATABASE_URL).
CMS_DATABASE_URL=postgres://cms:cms@127.0.0.1:55441/cms
PAYLOAD_SECRET=replace-with-at-least-32-random-characters-0000

# HMAC keys of apps/app for /svc/v1 (X-Svc-Signature). Two keys are valid at the same time for rotation.
CMS_SVC_APP_KEY=replace-with-at-least-32-random-characters-1111
# CMS_SVC_APP_KEY_NEXT=

# The only origin allowed for CORS and CSRF (the admin UI). Must be HTTPS in production.
CMS_ADMIN_ORIGIN=http://localhost:3300

# Local media directory (S3 follows with the cluster tickets).
# CMS_MEDIA_DIR=./media

# Build metadata, injected by CI/Docker (same names as app and marketing).
# BLOOMMD_RELEASE_VERSION=
# BLOOMMD_BUILD_SHA=
# BLOOMMD_BUILD_TAG=
# BLOOMMD_BUILD_TIME=
