# BloomMD Marketing App Configuration
# App root: apps/marketing, domain: https://bloommd.io

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3212
NEXT_PUBLIC_MARKETING_URL=http://127.0.0.1:3212
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3210
NEXT_PUBLIC_DESKTOP_MACOS_ARM64_DOWNLOAD_URL=

# Waitlist-only persistence. Do not use DATABASE_URL in the marketing app.
BLOOMMD_WAITLIST_DATABASE_URL=
BLOOMMD_WAITLIST_PENDING_RETENTION_DAYS=30
BLOOMMD_WAITLIST_UNSUBSCRIBED_RETENTION_DAYS=90

# Waitlist admin -> product app beta invites.
BLOOMMD_APP_INTERNAL_URL=http://127.0.0.1:3210
BLOOMMD_INTERNAL_INVITE_SECRET=

# Billing/auth/sync/product secrets must stay unset in this app.
BLOOMMD_BILLING_ENABLED=0

# Optional server-side public roadmap sync. Use a read-only GitHub token; it is never exposed to the browser.
BLOOMMD_ROADMAP_GITHUB_TOKEN=

# Transactional email for waitlist double opt-in
RESEND_API_KEY=
RESEND_FROM_EMAIL=BloomMD <hello@bloommd.io>

# Monitoring and optional M1 analytics.
# M1 decision: leave PostHog unset unless analytics is explicitly approved for the deployment.
# If enabled, events load only after consent and only use the allowlist in src/lib/telemetryPrivacy.ts.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.moellenbeck-digital.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.moellenbeck-digital.io

# Legal pages
BLOOMMD_LEGAL_BUSINESS_NAME=
BLOOMMD_LEGAL_OWNER_NAME=
BLOOMMD_LEGAL_STREET=
BLOOMMD_LEGAL_POSTAL_CITY=
BLOOMMD_LEGAL_COUNTRY=Deutschland
BLOOMMD_LEGAL_EMAIL=
BLOOMMD_LEGAL_PHONE=
BLOOMMD_LEGAL_REGISTER_COURT=
BLOOMMD_LEGAL_REGISTER_NUMBER=
BLOOMMD_LEGAL_VAT_ID=
BLOOMMD_LEGAL_RESPONSIBLE_CONTENT=
