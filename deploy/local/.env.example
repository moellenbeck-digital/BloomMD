# Copy to `deploy/local/.env` — that file is git-ignored and must stay that way.
#
# Both secrets are required and have no default: the sync server refuses to start without a
# 32-character secret when it is backed by a database, and a placeholder that "works" would be the
# kind of value that quietly follows a copy-paste into production.
#
#   openssl rand -hex 32

BLOOMMD_SYNC_SECRET=
BLOOMMD_AUTH_SECRET=

# The rest have working defaults; override only if a port is taken.
# POSTGRES_USER=bloommd
# POSTGRES_PASSWORD=bloommd-local-dev
# POSTGRES_DB=bloommd
# POSTGRES_PORT=55432
# SYNC_PORT=4100
# WEB_PORT=3000
# SYNC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# NEXT_PUBLIC_SYNC_URL=ws://localhost:4100
# Optional persistence bounds. A timed-out save is reconciled, never blindly retried.
# SYNC_PERSIST_RETRY_MAX_ATTEMPTS=3
# SYNC_PERSIST_RETRY_BASE_MS=100
# SYNC_PERSIST_RETRY_MAX_DELAY_MS=2000
# SYNC_PERSIST_RETRY_MAX_DURATION_MS=10000
# SYNC_PERSIST_SAVE_TIMEOUT_MS=15000
# Bounds the complete SIGTERM/SIGINT drain. Docker grants the service 30 seconds in total.
# SYNC_SHUTDOWN_TIMEOUT_MS=20000
