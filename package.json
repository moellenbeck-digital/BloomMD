{
  "name": "bloommd",
  "license": "Elastic-2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/core",
    "packages/ui",
    "packages/agent-runtime",
    "packages/wiki-cli",
    "packages/desktop",
    "packages/mobile",
    "packages/capacitor-folder",
    "packages/capacitor-keychain",
    "packages/ink",
    "packages/sync",
    "plugins/*"
  ],
  "overrides": {
    "basic-ftp": "6.2.2",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "happy-dom": "21.0.4",
    "import-in-the-middle": "3.3.3",
    "ip-address": "10.7.4",
    "moment": "2.31.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "browserslist": "4.28.9",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "@xmldom/xmldom": "0.9.12"
  },
  "scripts": {
    "dev": "bun run dev:app",
    "dev:app": "bun run --filter @bloommd/web-app dev",
    "dev:marketing": "bun run --filter @bloommd/marketing dev",
    "dev:sync": "bun run --filter @bloommd/sync dev",
    "build": "bun run --filter '*' build && bun run --cwd plugins/obsidian build",
    "build:app": "bun run --filter @bloommd/web-app build",
    "build:marketing": "bun run --filter @bloommd/marketing build",
    "build:desktop-renderer": "bun run --cwd packages/desktop build:renderer",
    "build:desktop-macos": "bun run --cwd packages/desktop build:stable",
    "build:desktop-linux": "bun run --cwd packages/desktop build:stable:linux",
    "package:desktop-arch": "bun run --cwd packages/desktop package:arch",
    "verify:desktop-macos": "bun run --cwd packages/desktop verify:stable",
    "verify:desktop-linux": "bun run --cwd packages/desktop verify:linux",
    "verify:desktop-macos:dmg": "bun run --cwd packages/desktop verify:dmg",
    "verify:desktop-macos:codesign": "bun run --cwd packages/desktop verify:codesign",
    "build:agent-runtime-binary": "bun run --cwd packages/agent-runtime build:binary",
    "build:wiki-cli-binary": "bun run --cwd packages/wiki-cli build:binary",
    "build:agent-runtime-release": "bun run --cwd packages/agent-runtime build:release",
    "build:wiki-cli-release": "bun run --cwd packages/wiki-cli build:release",
    "build:sync-binary": "bun run --cwd packages/sync build:binary",
    "build:release-artifacts": "bun run build:agent-runtime-release && bun run build:wiki-cli-release && bun run build:sync-binary",
    "test": "bun run --filter @bloommd/web-app test && bun run --filter @bloommd/marketing test && bun run --filter @bloommd/agent-runtime test && bun run --filter @bloommd/core test && bun run --filter @bloommd/desktop test && bun run --filter @bloommd/mobile test && bun run --filter @bloommd/sync test && bun run --filter @bloommd/ui test && bun run --filter @bloommd/ink test && bun run --filter @bloommd/wiki-cli test && bun run --cwd plugins/obsidian test && bun test tests/integration/*.test.ts",
    "test:qa": "bun test scripts/qa/*.test.ts",
    "docs:verify": "bun scripts/check-architecture-docs.ts",
    "test:e2e": "bun run --cwd apps/app test:e2e",
    "test:e2e:marketing": "bun run --cwd apps/marketing test:e2e",
    "test:e2e:collaboration": "bun run --cwd apps/app test:e2e:collaboration",
    "test:e2e:agent": "bun run deploy/local/agent-e2e/run.ts",
    "test:smoke:openclaw-release": "bash scripts/smoke-openclaw-plugin-release.sh",
    "test:e2e:visual": "bun run test:e2e:visual:app && bun run test:e2e:visual:marketing",
    "test:e2e:visual:app": "bun run --cwd apps/app test:e2e:visual",
    "test:e2e:visual:marketing": "bun run --cwd apps/marketing test:e2e:visual",
    "typecheck": "bun run --filter '*' typecheck && bun run --cwd plugins/obsidian typecheck",
    "qa:m1:mac": "bun scripts/qa/run-m1-mac.ts",
    "qa:m1:mac:html": "bun scripts/qa/run-m1-mac.ts --html",
    "qa:obsidian-clean-vault": "bun scripts/qa/prepare-obsidian-clean-vault.ts",
    "obsidian:mirror": "scripts/sync-obsidian-repo.sh",
    "obsidian:mirror:check": "scripts/sync-obsidian-repo.sh --check",
    "qa:production-smoke": "bun scripts/qa/run-production-smoke.ts",
    "qa:production-auth-smoke": "bun run --cwd apps/app production-auth-smoke",
    "wiki": "bun run --cwd packages/wiki-cli src/index.ts",
    "wiki:mcp": "bun run --cwd packages/wiki-cli src/index.ts mcp",
    "qa:obsidian-ink-smoke": "node scripts/qa/obsidian-ink-smoke.ts"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.2.5",
    "@xyflow/react": "^12.11.2",
    "@xyflow/system": "^0.0.79",
    "classcat": "^5.0.5",
    "d3-color": "^3.1.0",
    "d3-dispatch": "^3.0.1",
    "d3-drag": "^3.0.0",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-timer": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "dagre": "^0.8.5",
    "lucide-react": "^1.30.0",
    "react-resizable-panels": "^4.12.2",
    "y-protocols": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
