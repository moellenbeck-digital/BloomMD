  "name": "@bloommd/desktop",
  "version": "0.5.15",
  "license": "Elastic-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electrobun dev",
    "dev:hmr": "vite build && (vite build --watch --emptyOutDir false & watch_pid=$!; electrobun dev; status=$?; kill $watch_pid 2>/dev/null || true; wait $watch_pid 2>/dev/null || true; exit $status)",
    "build": "vite build && node ../../scripts/check-vite-bundle.mjs dist 1350000 40000 && electrobun build",
    "build:stable": "vite build && node ../../scripts/check-vite-bundle.mjs dist 1350000 40000 && electrobun build --env=stable",
    "build:renderer": "vite build && node ../../scripts/check-vite-bundle.mjs dist 1350000 40000",
    "build:stable:linux": "vite build && node ../../scripts/check-vite-bundle.mjs dist 1350000 40000 && electrobun build --env=stable",
    "package:arch": "bash ../../packaging/arch/build-package.sh",
    "verify:linux": "bash ./scripts/verify-linux.sh",
    "verify:dmg": "./scripts/verify-dmg.sh",
    "verify:codesign": "codesign --verify --deep --strict --verbose=2 build/stable-macos-arm64/BloomMD.app",
    "verify:stable": "bun run verify:dmg && bun run verify:codesign",
    "test": "bun test src/bun/*.test.ts src/mainview/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:release:macos": "BLOOMMD_MACOS_RELEASE=1 bun run build:stable",
    "verify:release:macos": "bun scripts/verify-macos-release.ts"
  },
