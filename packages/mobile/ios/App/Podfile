require_relative '../../../../node_modules/.bun/@capacitor+ios@8.5.1+537b06cc52f15837/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.bun/@capacitor+ios@8.5.1+537b06cc52f15837/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.bun/@capacitor+ios@8.5.1+537b06cc52f15837/node_modules/@capacitor/ios'
  pod 'BloommdCapacitorFolder', :path => '../../../capacitor-folder'
  pod 'BloommdCapacitorKeychain', :path => '../../../capacitor-keychain'
  pod 'CapacitorApp', :path => '../../../../node_modules/.bun/@capacitor+app@8.1.1+537b06cc52f15837/node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../../../node_modules/.bun/@capacitor+browser@8.0.5+537b06cc52f15837/node_modules/@capacitor/browser'
  pod 'CapacitorFilesystem', :path => '../../../../node_modules/.bun/@capacitor+filesystem@8.1.2+537b06cc52f15837/node_modules/@capacitor/filesystem'
  pod 'CapacitorShare', :path => '../../../../node_modules/.bun/@capacitor+share@8.0.1+537b06cc52f15837/node_modules/@capacitor/share'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
